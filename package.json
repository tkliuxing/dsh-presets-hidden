{
  "name": "dsh-presets-hidden",
  "version": "0.2.0",
  "description": "UI-only agent preset visibility and ordering controls for DeepSeek Harness",
  "license": "MIT",
  "author": "tkliuxing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkliuxing/dsh-presets-hidden.git"
  },
  "bugs": {
    "url": "https://github.com/tkliuxing/dsh-presets-hidden/issues"
  },
  "homepage": "https://github.com/tkliuxing/dsh-presets-hidden#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "agent-presets",
    "cordis"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "dsh": ">=0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc --noEmit && tsdown",
    "bundle": "pnpm run clean && tsdown",
    "prepare": "pnpm run bundle",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@types/node": "^22.20.4",
    "@types/react": "~18.3.1",
    "immer": "^10.2.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zustand": "~4.4.7"
  }
}
